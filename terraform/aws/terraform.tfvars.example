# Example Terraform variables file
# Copy this file to terraform.tfvars and customize for your environment

# General Configuration
aws_region   = "us-east-1"
environment  = "dev"
project_name = "aether"

# VPC Configuration
vpc_cidr             = "10.0.0.0/16"
az_count             = 3
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# For development, use single NAT gateway to save costs
single_nat_gateway = true

# RDS Configuration
db_instance_class           = "db.t3.medium"
db_allocated_storage        = 20
db_max_allocated_storage    = 100
db_multi_az                 = false  # Set to true for production
db_backup_retention_period  = 7

# ElastiCache Configuration
redis_node_type             = "cache.t3.micro"
redis_num_cache_nodes       = 1  # Increase for production
redis_automatic_failover_enabled = false  # Set to true with 2+ nodes

# ECS Configuration
container_image    = "ghcr.io/aether-runtime/aether:latest"
container_cpu      = 1024
container_memory   = 2048
ecs_desired_count  = 2
ecs_min_capacity   = 1
ecs_max_capacity   = 10

# Tags
common_tags = {
  Team        = "platform"
  Owner       = "devops@example.com"
  Project     = "aether"
  Environment = "dev"
  ManagedBy   = "terraform"
}
