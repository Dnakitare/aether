# Docker Makefile for Aether Runtime
# Provides convenient targets for Docker operations
#
# Usage:
#   make -f Makefile.docker build        # Build Docker image
#   make -f Makefile.docker run          # Run container
#   make -f Makefile.docker scan         # Security scan
#   make -f Makefile.docker push         # Push to registry

.PHONY: help
help: ## Show this help message
	@echo 'Usage: make -f Makefile.docker [target]'
	@echo ''
	@echo 'Available targets:'
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# Variables
IMAGE_NAME ?= aether
IMAGE_TAG ?= latest
IMAGE_REGISTRY ?= ghcr.io/aether-runtime
FULL_IMAGE_NAME = $(IMAGE_REGISTRY)/$(IMAGE_NAME):$(IMAGE_TAG)

VERSION ?= 0.2.0-beta
COMMIT_SHA ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
BUILD_DATE ?= $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")

DOCKERFILE = deployments/docker/Dockerfile
DOCKER_BUILD_ARGS = --build-arg VERSION=$(VERSION) \
                    --build-arg COMMIT_SHA=$(COMMIT_SHA) \
                    --build-arg BUILD_DATE=$(BUILD_DATE)

# Build targets
.PHONY: build
build: ## Build Docker image
	@echo "Building Docker image: $(FULL_IMAGE_NAME)"
	docker build $(DOCKER_BUILD_ARGS) \
		-t $(FULL_IMAGE_NAME) \
		-t $(IMAGE_REGISTRY)/$(IMAGE_NAME):$(VERSION) \
		-t $(IMAGE_REGISTRY)/$(IMAGE_NAME):latest \
		-f $(DOCKERFILE) .
	@echo "Image built successfully"

.PHONY: build-no-cache
build-no-cache: ## Build Docker image without cache
	@echo "Building Docker image (no cache): $(FULL_IMAGE_NAME)"
	docker build --no-cache $(DOCKER_BUILD_ARGS) \
		-t $(FULL_IMAGE_NAME) \
		-f $(DOCKERFILE) .

.PHONY: build-dev
build-dev: ## Build development image with debug symbols
	@echo "Building development image"
	docker build \
		--build-arg GO_VERSION=1.22 \
		--target builder \
		-t $(IMAGE_NAME):dev \
		-f $(DOCKERFILE) .

# Run targets
.PHONY: run
run: ## Run Docker container
	docker run --rm -it \
		-p 8080:8080 \
		-e AETHER_LOG_LEVEL=debug \
		$(FULL_IMAGE_NAME)

.PHONY: run-detached
run-detached: ## Run Docker container in background
	docker run -d \
		--name aether-runtime \
		-p 8080:8080 \
		$(FULL_IMAGE_NAME)

.PHONY: stop
stop: ## Stop running container
	docker stop aether-runtime || true
	docker rm aether-runtime || true

# Compose targets
.PHONY: compose-up
compose-up: ## Start all services with docker-compose
	docker-compose up -d
	@echo "Services started. Access:"
	@echo "  Aether API:  http://localhost:8080"
	@echo "  Jaeger UI:   http://localhost:16686"
	@echo "  Prometheus:  http://localhost:9090"
	@echo "  Grafana:     http://localhost:3000"

.PHONY: compose-down
compose-down: ## Stop all services
	docker-compose down

.PHONY: compose-logs
compose-logs: ## Show logs from all services
	docker-compose logs -f

.PHONY: compose-restart
compose-restart: compose-down compose-up ## Restart all services

# Security scanning
.PHONY: scan
scan: scan-trivy ## Run security scan on image

.PHONY: scan-trivy
scan-trivy: ## Scan image with Trivy
	@echo "Scanning image with Trivy..."
	@if command -v trivy >/dev/null 2>&1; then \
		trivy image --severity HIGH,CRITICAL $(FULL_IMAGE_NAME); \
	else \
		echo "Trivy not installed. Install with: brew install trivy"; \
		exit 1; \
	fi

.PHONY: scan-grype
scan-grype: ## Scan image with Grype
	@echo "Scanning image with Grype..."
	@if command -v grype >/dev/null 2>&1; then \
		grype $(FULL_IMAGE_NAME); \
	else \
		echo "Grype not installed. Install with: brew install grype"; \
		exit 1; \
	fi

.PHONY: scan-docker
scan-docker: ## Scan image with Docker Scout
	@echo "Scanning image with Docker Scout..."
	docker scout cves $(FULL_IMAGE_NAME)

# Image inspection
.PHONY: inspect
inspect: ## Inspect Docker image
	docker inspect $(FULL_IMAGE_NAME)

.PHONY: history
history: ## Show image layer history
	docker history $(FULL_IMAGE_NAME)

.PHONY: size
size: ## Show image size
	@docker images $(FULL_IMAGE_NAME) --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"

.PHONY: dive
dive: ## Analyze image layers with dive
	@if command -v dive >/dev/null 2>&1; then \
		dive $(FULL_IMAGE_NAME); \
	else \
		echo "Dive not installed. Install with: brew install dive"; \
		exit 1; \
	fi

# Registry operations
.PHONY: login
login: ## Login to container registry
	@echo "Logging into $(IMAGE_REGISTRY)..."
	@echo "$$GITHUB_TOKEN" | docker login $(IMAGE_REGISTRY) -u $(GITHUB_USER) --password-stdin

.PHONY: push
push: ## Push image to registry
	@echo "Pushing image: $(FULL_IMAGE_NAME)"
	docker push $(FULL_IMAGE_NAME)
	docker push $(IMAGE_REGISTRY)/$(IMAGE_NAME):$(VERSION)
	docker push $(IMAGE_REGISTRY)/$(IMAGE_NAME):latest

.PHONY: pull
pull: ## Pull image from registry
	docker pull $(FULL_IMAGE_NAME)

# Cleanup
.PHONY: clean
clean: ## Remove local Docker images
	docker rmi $(FULL_IMAGE_NAME) || true
	docker rmi $(IMAGE_REGISTRY)/$(IMAGE_NAME):$(VERSION) || true
	docker rmi $(IMAGE_REGISTRY)/$(IMAGE_NAME):latest || true

.PHONY: prune
prune: ## Remove unused Docker resources
	docker system prune -f
	docker volume prune -f

# Testing
.PHONY: test-healthcheck
test-healthcheck: ## Test healthcheck endpoint
	@echo "Testing healthcheck..."
	docker run --rm $(FULL_IMAGE_NAME) healthcheck

.PHONY: test-version
test-version: ## Show version information
	@echo "Version information:"
	docker run --rm $(FULL_IMAGE_NAME) version

.PHONY: shell
shell: ## Get shell in running container
	docker exec -it aether-runtime /bin/sh

# CI/CD targets
.PHONY: ci-build
ci-build: build scan ## Build and scan for CI/CD

.PHONY: ci-release
ci-release: build scan push ## Full release pipeline

# Development helpers
.PHONY: logs
logs: ## Show container logs
	docker logs -f aether-runtime

.PHONY: stats
stats: ## Show container resource usage
	docker stats aether-runtime

.PHONY: exec
exec: ## Execute command in running container (usage: make exec CMD="command")
	docker exec -it aether-runtime $(CMD)

# Multi-platform build
.PHONY: buildx-setup
buildx-setup: ## Set up Docker buildx for multi-platform builds
	docker buildx create --name aether-builder --use || true
	docker buildx inspect --bootstrap

.PHONY: buildx-build
buildx-build: buildx-setup ## Build multi-platform image
	docker buildx build $(DOCKER_BUILD_ARGS) \
		--platform linux/amd64,linux/arm64 \
		-t $(FULL_IMAGE_NAME) \
		-f $(DOCKERFILE) \
		--push .

# Documentation
.PHONY: readme
readme: ## Generate Dockerfile documentation
	@echo "Dockerfile information:"
	@echo "  Location: $(DOCKERFILE)"
	@echo "  Base image: golang:1.22-alpine (builder)"
	@echo "  Runtime: gcr.io/distroless/static:nonroot"
	@echo "  Size: ~10MB (compressed)"
	@echo "  User: non-root (UID 10001)"
	@echo "  Port: 8080"
